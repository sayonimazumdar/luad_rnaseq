#!/usr/bin/env bash
# 02_multiqc_tx2gene.sh : combined QC report, mapping-rate check, tx2gene table for tximport
# Run from the project root (luad-rnaseq/):  bash scripts/02_multiqc_tx2gene.sh
# Reads:  qc/ (fastp), quants/<sample>/ (Salmon), ref/gencode.v47.annotation.gtf.gz
# Writes: results/multiqc/, results/salmon_mapping_rates.tsv, ref/tx2gene.tsv
set -euo pipefail

[ -d quants ] && [ -d ref ] || { echo "Run from the project root (needs quants/ and ref/)"; exit 1; }
mkdir -p results/multiqc

GENCODE_REL=47     # must match 00_setup.sh

# ---- 1. MultiQC over fastp + Salmon outputs ----
multiqc qc quants -o results/multiqc -n multiqc_report

# ---- 2. Salmon mapping rates (expect roughly 60-70%+ ; investigate samples far below) ----
echo -e "sample\tpercent_mapped"
for f in quants/*/aux_info/meta_info.json; do
    sample=$(basename "$(dirname "$(dirname "${f}")")")
    pm=$(grep -o '"percent_mapped": *[0-9.]*' "${f}" | grep -o '[0-9.]*$')
    echo -e "${sample}\t${pm}"
done | tee results/salmon_mapping_rates.tsv

# ---- 3. tx2gene table (transcript ID, gene ID, gene symbol) from the GTF ----
zcat ref/gencode.v${GENCODE_REL}.annotation.gtf.gz | awk -F'\t' '
BEGIN { print "transcript_id\tgene_id\tgene_name" }
$3 == "transcript" {
    match($9, /gene_id "[^"]+"/);       g = substr($9, RSTART + 9,  RLENGTH - 10)
    match($9, /transcript_id "[^"]+"/); t = substr($9, RSTART + 15, RLENGTH - 16)
    match($9, /gene_name "[^"]+"/);     n = substr($9, RSTART + 11, RLENGTH - 12)
    print t "\t" g "\t" n
}' > ref/tx2gene.tsv

echo "tx2gene rows: $(($(wc -l < ref/tx2gene.tsv) - 1))"
echo "Next: run the R script (tximport + DESeq2) using quants/*/quant.sf and ref/tx2gene.tsv"
